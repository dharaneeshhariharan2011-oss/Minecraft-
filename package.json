{
  "name": "minecraft-by-dh-bedrock",
  "version": "1.0.0",
  "description": "Minecraft by DH: Bedrock Edition - a voxel sandbox with data-driven packs, redstone, multi-dimension worlds and friend-code multiplayer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "lint": "npm run typecheck"
  },
  "license": "MIT",
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.65.0",
    "typescript": "~5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
